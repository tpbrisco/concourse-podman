[Unit]
Description=Concourse web

[Container]
ContainerName=concourse-web
Image=concourse.image
Pod=concourse.pod
StartWithPod=true
Exec=web
Volume=concourse-web-state:/worker-state
Volume=/etc/localtime:/etc/localtime:ro
Volume=/etc/concourse/keys/web:/concourse-keys:z
Environment=CONCOURSE_SESSION_SIGNING_KEY=/concourse-keys/session_signing_key
Environment=CONCOURSE_TSA_HOST_KEY=/concourse-keys/tsa_host_key
Environment=CONCOURSE_TSA_AUTHORIZED_KEYS=/concourse-keys/authorized_worker_keys.pub
Environment=CONCOURSE_EXTERNAL_URL=http://con44.inmyshorts.org:8080
Environment=CONCOURSE_POSTGRES_HOST=localhost
Environment=CONCOURSE_POSTGRES_USER=concourse_user
Environment=CONCOURSE_POSTGRES_PASSWORD=concourse_pass
Environment=CONCOURSE_POSTGRES_DATABASE=concourse
EnvironmentFile=/etc/concourse/concourse.env
LogDriver=json-file
LogOpt=max-size=10m
LogOpt=max-file=5

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
